# Copie para `.env` na raiz do projeto (Next.js carrega automaticamente).

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Obrigatório em produção.
AUTH_SECRET=substitua-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# PostgreSQL — subir com: npm run db:up
# Windows: use host 127.0.0.1 (localhost costuma falhar no Node com erro 28P01).
DATABASE_URL=postgresql://cobranca:cobranca_dev@127.0.0.1:5433/cobranca_condominial

# Após npm run db:migrate && npm run db:seed — login do sistema: código 1234, senha 1234.
