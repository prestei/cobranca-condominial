# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Obrigatório em produção.
AUTH_SECRET=substitua-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# PostgreSQL (obrigatório para cargos e permissões no servidor)
# Opção A (recomendada): Docker — `docker compose up -d` na raiz do projeto
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cobranca_condominial

# Opção B: PostgreSQL já instalado no Windows (ajuste usuário, senha e porta)
# DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/cobranca_condominial

# Após npm run db:migrate && npm run db:seed — login: código 1234, senha 1234 (Prestei, Administrador).
