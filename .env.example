# Copie para `.env` na raiz do projeto (Next.js carrega automaticamente).

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Obrigatório em produção.
AUTH_SECRET=substitua-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# PostgreSQL local (ajuste usuário, senha, porta e banco conforme o seu ambiente)
DATABASE_URL=postgresql://cobranca:cobranca_dev@localhost:5432/cobranca_condominial

# Login de demonstração (dados em src/data/catalogo.ts): código MILENA, senha 12345.
