# Copie para `.env` na raiz do projeto (Next.js carrega automaticamente).

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Obrigatório em produção.
AUTH_SECRET=substitua-por-um-valor-aleatorio-com-pelo-menos-32-caracteres

# PostgreSQL — obrigatório. Fonte única da verdade (sem memória durável, sem Docker, sem .data).
DATABASE_URL=postgresql://cobranca:cobranca_dev@127.0.0.1:5432/cobranca_condominial

# Depois da URL, aplique as migrations Prisma:
#   npm run db:migrate        # deploy (produção/CI)
#   npm run db:migrate:dev    # desenvolvimento local

# Push Firebase (opcional). Sem estas variáveis, permanecem só notificações in-app (sino).
# Console Firebase → Configurações do projeto → Suas apps (Web) + Cloud Messaging (chave VAPID).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@....iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Alternativa: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Assistente de ajuda (OpenRouter) — opcional; sem chave o botão avisa que o recurso não está ativo.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash  (sem :online / :web — assistente só usa contexto interno)
# OPENROUTER_SITE_URL=https://seu-dominio.exemplo
# OPENROUTER_APP_NAME=Cobrança Condominial
