[Unit]
Description=Cobrança condominial — auto deploy (git pull + rebuild)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=APP_DIR=/opt/cobranca-condominial
Environment=DEPLOY_BRANCH=main
Environment=DEPLOY_REMOTE=origin
Environment=DOCKER_BUILDKIT=0
ExecStart=/opt/cobranca-condominial/deploy/scripts/auto-deploy-pull.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
