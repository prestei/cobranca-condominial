[Unit]
Description=Cobrança condominial — auto deploy (git pull + build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=APP_DIR=/opt/cobranca-condominial
Environment=DEPLOY_BRANCH=main
Environment=DEPLOY_REMOTE=origin
ExecStart=/opt/cobranca-condominial/deploy/scripts/auto-deploy-pull.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
