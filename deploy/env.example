# Copie para deploy/.env.production (principal) ou deploy/.env.standby (contingência).
# NÃO versionar arquivos com senhas reais.

# --- Domínio / SSL (Caddy + Let's Encrypt) ---
DOMAIN=danieljorgeadv.com
ACME_EMAIL=admin@danieljorgeadv.com

# --- App ---
AUTH_SECRET=gere-com-openssl-rand-hex-32
DATABASE_URL=postgresql://cobranca:ALTERE_SENHA_DB@db:5432/cobranca_condominial
NODE_OPTIONS=--max-old-space-size=384

# --- PostgreSQL primary ---
POSTGRES_DB=cobranca_condominial
POSTGRES_USER=cobranca
POSTGRES_PASSWORD=ALTERE_SENHA_DB
POSTGRES_PUBLISH_PORT=5432

# Replicação (banco espelho / contingência)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=ALTERE_SENHA_REPLICACAO
# Quando a VPS de contingência existir, restrinja (ex.: 203.0.113.10/32)
REPLICA_CIDR=0.0.0.0/0

# --- Standby only (deploy/.env.standby) ---
# PRIMARY_HOST=162.35.125.252
# PRIMARY_PORT=5432
